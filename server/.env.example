# Copy to .env and edit. Any OpenAI-compatible vision model works: a cloud API or one you host yourself.
# ACTOR_* / PLANNER_* override LLM_* for one role (e.g. a fast actor and a stronger planner).

# --- Cloud API (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini          # any vision-capable chat model
LLM_API_KEY=
LLM_EXTRA_BODY='{}'
# Newer OpenAI models want max_completion_tokens instead of max_tokens; "auto" (default) detects it.
# LLM_TOKEN_PARAM=auto            # auto | max_tokens | max_completion_tokens

# --- Local model (optional): vLLM, SGLang, llama.cpp server, Ollama, ... ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen3.8-Flash-Next
# LLM_API_KEY=
# Qwen3.8 is tested; turn its thinking mode off for fast, short replies:
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# --- Per-role overrides (optional) ---
# ACTOR_MODEL=...      picks one action per screenshot: fast matters most
# PLANNER_MODEL=...    writes and repairs the plan

# --- Security ---
# Shared with the board (DEVICE_KEY in hardware/hid_bridge/secrets.h). Required; at least 16 characters:
#   python3 -c 'import secrets; print(secrets.token_hex(16))'
DEVICE_KEY=
# UI_TOKEN=...                 web UI token; generated and kept in ~/.hidagent/ui_token when unset
# AIRPLAY_PIN=1234             4 digits a phone enters once; generated and kept in ~/.hidagent/airplay_pin; off = no pin

AIRPLAY_NAME='iPhone Agent'   # receiver name shown in the phone's Screen Mirroring list
# HOST=127.0.0.1              # web UI for this computer only (default 0.0.0.0: the token is still required)
PORT=8890                     # web UI
DEVICE_PORT=7300              # the ESP32 board connects here
# --- Action gate (optional): a second opinion from Jev on each action, OBSERVE ONLY (never changes what is done) ---
# GATE_MODE=observe            # off (default) | observe; needs jevlib (JEVLIB_PATH) and a Jev key (TYPESAFE_API_KEY…)

# 1: verbose logs + one trace folder per agent run (prompts, replies, screenshots) in ~/.hidagent/traces
HIDAGENT_DEBUG=0

# Screen over a VPN (companion iOS app) instead of AirPlay -- see README "Screen over a VPN"
# SCREEN_SOURCE=push
# PUSH_HOST=100.x.y.z        # this computer's VPN (Tailscale) address; a wildcard is refused
# PUSH_PORT=8891
# PUSH_TOKEN=                # generated and kept in ~/.hidagent/push_token when unset

# Text on the screen with coordinates (optional): pip install -e '.[ocr]'  -- see README "Screen text (OCR)"
# OCR_MODE=api                 # off | api (GET /api/screen_text; default when installed) | actor (also fed to the actor)

# Home Screen (optional): iOS 27 ignores the bottom-edge flick from a pointer -- go home through AssistiveTouch instead
# HOME_METHOD=assistivetouch      # swipe (default) | assistivetouch
# ASSISTIVETOUCH_BUTTON=0.9,0.27  # where the AssistiveTouch button sits (screen fractions x,y)
# ASSISTIVETOUCH_MENU_HOME=0.6,0.34  # the menu's Home item; leave out if Single-Tap is set to Home
